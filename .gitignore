# Personal data — lives ONLY in the separate private repo
# (F:\Halal-Career-Private, github.com/moin-ai/halal-career-private).
# In this working tree these paths are hardlinks/junctions into that repo
# so scripts keep working — but they must NEVER be tracked here.
# See docs/PROJECT-STATE.md "Data split" for the architecture.
tracker.md
cv.md
knowledge/employer-index.md
knowledge/companies/
reports/
output/
batch/tracker-additions/
jds/*
!jds/.gitkeep

# data/*        ← tracked
# config/profile.yml ← tracked
# portals.yml   ← tracked
# modes/_profile.md  ← tracked

batch/logs/*
!batch/logs/.gitkeep
batch/batch-state.tsv
batch/batch-input.tsv

# Writing samples (user's personal files — never committed)
writing-samples/*
!writing-samples/README.md

# Temp files
.update-dismissed
.update-lock

# Secrets (never commit — use .env.example as template)
.env

# Generated
.resolved-prompt-*
node_modules/
bun.lock

# OS
.DS_Store
*.mov
*.mp4

# Claude Code local
.claude/settings.local.json
.claude/memory/
career-dashboard
package-lock.json